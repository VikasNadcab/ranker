  "eligibility": {
    "qualification": "Graduation (any discipline)",
    "age_limit": "20 to 33 years",
    "medical_standard": "A-2 (as per Indian Railways medical standards)"
  },
  "selection_process": ["CBT (Computer Based Test)", "CBAT (Computer Based Aptitude Test)", "Document Verification", "Medical Examination"],
  "pay_level": "Level 6 (7th CPC)",
  "basic_pay": "Rs. 35,400 - Rs. 1,12,400",
  "grade_pay": "Rs. 4,200",
  "job_profile": "Station Master - responsible for overall management and operation of railway station, train movements, safety, commercial activities",
  "exam_pattern": {
    "type": "Single Stage CBT (Computer Based Test)",
    "total_questions": 100,
    "total_marks": 100,
    "duration_minutes": 90,
    "marking_scheme": "+1 for correct, -1/3 for incorrect",
    "negative_marking": "1/3 mark deducted per wrong answer",
    "language": "English, Hindi and other regional languages",
    "sections": [
      {
        "section": "Basic Science & Mathematics",
        "marks": 30,
        "topics": [
          "Number System", "Ratio & Proportions", "Averages", "Percentages", "Profit, Loss & Discounts",
          "Time, Speed, Distance", "Power & Work", "Algebra", "Linear Equations",
          "Arithmetic Progression", "LCM, HCF", "Geometry and Trigonometry", "Area & Volumes",
          "Probability and Statistics (Basic Level)", "Units, Measurements", "Mass, Weight and Density",
          "Work, Power, Energy", "Kinetic Energy", "Friction", "Speed, Velocity, Relative Velocity",
          "Heat and Temperature", "Basic Electricity", "Levers and Simple Machines"
        ]
      },
      {
        "section": "Data Analysis & Interpretation",
        "marks": 30,
        "topics": [
          "Multi-source Data Analysis", "Examination and analysis of text", "Tabular data analysis",
          "Graphical data (charts, graphs, scatter plot, pie chart, statistical curve distribution)",
          "Venn Diagrams", "Data Sufficiency", "Data Arrangement"
        ]
      },
      {
        "section": "Logical Capability",
        "marks": 20,
        "topics": {
          "logical_reasoning": [
            "Binary Logic", "Syllogism", "Clocks & Calendars", "Assumptions", "Blood Relations",
            "Family Tree", "Solving logic-based puzzles"
          ],
          "reading_comprehension": [
            "Passages from History, Society, Literature, Science, Environment, Abstract, Mythology, Technology, Culture",
            "Main idea", "Supporting idea", "Application", "Logical structure", "Style of paragraph"
          ]
        }
      },
      {
        "section": "Mental Reasoning",
        "marks": 20,
        "topics": [
          "Analogy - Identifying relationship between two items",
          "Series Completion - Identifying pattern in sequence of numbers",
          "Coding-Decoding type questions",
          "Ranking and Arrangement-based problems"
        ]
      }
    ]
  },
