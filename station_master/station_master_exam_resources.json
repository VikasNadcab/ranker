  "departmental_exam_syllabus": {
    "note": "For departmental promotions (25% promotional quota and 15% LDCE quota)",
    "subjects": [
      "General English (Sentence Correction, Sentence Construction)",
      "Arithmetic (Basic Arithmetic, Ratio and Proportion)",
      "General Awareness (Current events, Indian history, geography, railway-related knowledge)",
      "Official Language Policy and Rules",
      "D&AR Rules (Charge Sheets, Standard Forms, Major/Minor Penalty)",
      "Establishment Rules (Leave rules - LAP, LHAP, CCL, ML; Pass rules - Privilege Pass, PTO, Duty Pass)",
      "Commercial Rules (Wharfage, Demurrage, WDRF, PTO)",
      "Rules regarding working of Trains (Organisation setup, signalling systems, G&SR Chapter III, Caution Orders, Safety and Accidents, Commercial Documents, Station Working Rules)",
      "Engineering Line Block Procedures",
      "Level Crossing Gates",
      "Working on Electrified Sections (OHE failures, Power Block)",
      "Marshalling (Coaching Trains, POL trains)",
      "Shunting (Shunting instructions, authorities, Block forward/Block Back)",
      "Other Books (WTT, BWM, Accident Manual)",
      "New Technology (FOIS, COIS, ICMS, COA)"
